{
  "git.ignoreLimitWarning": true,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "files.eol": "\n",
  "editor.codeLens": false,
  "editor.formatOnSave": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.suppressSuggestions": false,
  "js/ts.preferences.importModuleSpecifierEnding": "js",
  "github.copilot.chat.localeOverride": "en",
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsserver.maxMemory": 4096,
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.preferences.includePackageJsonAutoImports": "off",
  "js/ts.workspaceSymbols.scope": "currentProject",
  "vue.server.hybridMode": true,
  "C_Cpp.files.exclude": {
    "**/externals/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/binary/**": true,
    "**/.tmp/**": true,
    "**/.git/**": true
  },
  "C_Cpp.autoAddFileAssociations": false,
  "files.watcherExclude": {
    "**/externals/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/binary/**": true,
    "**/.tmp/**": true
  },
  "search.exclude": {
    "**/externals": true,
    "**/dist": true,
    "**/build": true,
    "**/binary": true
  },
  "eslint.debug": false,
  "eslint.run": "onSave",
  "eslint.validate": [
    "javascript",
    "typescript",
  ],
  "eslint.workingDirectories": [
    {
      "mode": "auto"
    }
  ],
  "python.analysis.ignore": [
    "*"
  ],
  "files.associations": {
    ".gyp": "python",
    ".gypi": "python",
    "*.yaml": "yaml",
    "vector": "cpp"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "[yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit"
    }
  },
  "terminal.integrated.profiles.windows": {
    "MSYS2": {
      "path": "C:\\msys64\\usr\\bin\\bash.exe",
      "args": [
        "--login",
        "-i",
        "-c",
        "cd \"${workspaceFolder}\" 2>/dev/null || cd \"$(cygpath -u \"${env:PWD}\")\"; exec bash"
      ]
    },
    "MinGW64": {
      "path": "C:\\msys64\\mingw64\\bin\\bash.exe",
      "args": [
        "--login",
        "-i",
        "-c",
        "cd \"${workspaceFolder}\" 2>/dev/null || cd \"$(cygpath -u \"${env:PWD}\")\"; exec bash"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "MSYS2",
}